{
  "name": "chatter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chatter — Your community. Your conversations. Your Chatter.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit -p client/tsconfig.json",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.3.0",
    "multer": "^2.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "typescript": "^5.7.2",
    "vite": "^8.3.8"
  }
}
